{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "termiflow.expected_error_policy.record.v1",
  "title": "TermiFlow expected-error policy record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "case_id",
    "packet",
    "run_id",
    "policy_sha256",
    "record_schema_sha256",
    "fixture",
    "direction",
    "style",
    "mode",
    "input",
    "source_sha256",
    "input_sha256",
    "status",
    "stdout",
    "stderr",
    "expected_stderr",
    "stderr_policy",
    "stderr_contains",
    "result",
    "observation",
    "owner",
    "hypothesis",
    "expected_observation_if_true",
    "falsifier",
    "next_command",
    "reviewer",
    "timestamp"
  ],
  "properties": {
    "schema": {"const": "termiflow.expected_error_policy.record.v1"},
    "case_id": {"type": "string", "minLength": 1},
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_sha256",
        "identity_sha256",
        "complete_sha256",
        "packet_checksum_sha256",
        "packet_digest_sha256",
        "metadata_sha256"
      ],
      "properties": {
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "identity_sha256": {"$ref": "#/$defs/sha256"},
        "complete_sha256": {"$ref": "#/$defs/sha256"},
        "packet_checksum_sha256": {"$ref": "#/$defs/sha256"},
        "packet_digest_sha256": {"$ref": "#/$defs/sha256"},
        "metadata_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "run_id": {"$ref": "#/$defs/sha256"},
    "policy_sha256": {"$ref": "#/$defs/sha256"},
    "record_schema_sha256": {"$ref": "#/$defs/sha256"},
    "fixture": {"type": "string", "minLength": 1},
    "direction": {"enum": ["TD", "LR", "RL", "BT", "none"]},
    "style": {"type": "string", "minLength": 1},
    "mode": {"enum": ["default", "optimized"]},
    "input": {"type": "string", "minLength": 1},
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"type": "integer", "not": {"const": 0}},
    "stdout": {"$ref": "#/$defs/blob"},
    "stderr": {"$ref": "#/$defs/blob"},
    "expected_stderr": {"$ref": "#/$defs/blob"},
    "stderr_policy": {"const": "error"},
    "stderr_contains": {"type": "array", "items": {"type": "string"}},
    "result": {"const": "matched"},
    "observation": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "hypothesis": {"type": "string", "minLength": 1},
    "expected_observation_if_true": {"type": "string", "minLength": 1},
    "falsifier": {"type": "string", "minLength": 1},
    "next_command": {"type": "string", "minLength": 1},
    "reviewer": {"enum": ["ai", "human"]},
    "timestamp": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "blob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
