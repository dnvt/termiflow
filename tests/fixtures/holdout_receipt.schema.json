{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "termiflow.holdout_receipt.v1",
  "title": "TermiFlow evaluator-owned holdout receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "queue_id",
    "queue_sha256",
    "manifest_sha256",
    "spec_sha256",
    "packet",
    "expected_rows",
    "actual_rows",
    "status",
    "rows"
  ],
  "properties": {
    "schema": {"const": "termiflow.holdout_receipt.v1"},
    "queue_id": {"type": "string", "minLength": 1},
    "queue_sha256": {"$ref": "#/$defs/sha256"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "spec_sha256": {"$ref": "#/$defs/sha256"},
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "manifest_sha256", "identity_sha256", "packet_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "identity_sha256": {"$ref": "#/$defs/sha256"},
        "packet_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "expected_rows": {"type": "integer", "minimum": 1},
    "actual_rows": {"type": "integer", "minimum": 1},
    "status": {"enum": ["passed", "failed"]},
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "fixture",
          "variant_id",
          "style",
          "mode",
          "direction",
          "source_sha256",
          "input_path",
          "semantic",
          "review_targets",
          "status",
          "frame",
          "stderr",
          "evidence",
          "findings"
        ],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "fixture": {"type": "string", "minLength": 1},
          "variant_id": {"type": "string", "minLength": 1},
          "style": {"type": "string", "minLength": 1},
          "mode": {"type": "string", "minLength": 1},
          "direction": {"enum": ["TD", "LR", "BT", "RL"]},
          "source_sha256": {"$ref": "#/$defs/sha256"},
          "input_path": {"type": "string", "minLength": 1},
          "semantic": {"type": "object"},
          "review_targets": {"type": "array"},
          "status": {"enum": ["passed", "failed"]},
          "frame": {"$ref": "#/$defs/blob"},
          "stderr": {"$ref": "#/$defs/blob"},
          "evidence": {"type": ["object", "null"]},
          "findings": {"type": "object"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "blob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
