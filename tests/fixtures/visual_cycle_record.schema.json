{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "termiflow.visual_cycle_record.v2",
  "title": "TermiFlow visual improvement cycle record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "cycle_id",
    "disposition",
    "packet",
    "scope",
    "queue",
    "review",
    "holdout_review",
    "observation",
    "observation_details",
    "owner_layer",
    "hypothesis",
    "expected_observation_if_true",
    "falsifier",
    "next_command",
    "fix",
    "homologs",
    "holdout",
    "lesson",
    "golden_approval"
  ],
  "properties": {
    "schema": {"const": "termiflow.visual_cycle_record.v2"},
    "cycle_id": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["fixed", "hold", "falsified"]},
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete_sha256",
        "manifest_sha256",
        "identity_sha256",
        "packet_checksum_sha256"
      ],
      "properties": {
        "complete_sha256": {"$ref": "#/$defs/sha256"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "identity_sha256": {"$ref": "#/$defs/sha256"},
        "packet_checksum_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "queue",
        "packet",
        "review",
        "holdout",
        "fix",
        "homologs",
        "homolog_result",
        "golden_approval",
        "lesson"
      ],
      "properties": {
        "queue": {
          "type": "object",
          "additionalProperties": false,
          "required": ["queue_id", "queue_sha256", "manifest_sha256"],
          "properties": {
            "queue_id": {"type": "string", "minLength": 1},
            "queue_sha256": {"$ref": "#/$defs/sha256"},
            "manifest_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "packet": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "complete_sha256",
            "manifest_sha256",
            "identity_sha256",
            "packet_checksum_sha256"
          ],
          "properties": {
            "complete_sha256": {"$ref": "#/$defs/sha256"},
            "manifest_sha256": {"$ref": "#/$defs/sha256"},
            "identity_sha256": {"$ref": "#/$defs/sha256"},
            "packet_checksum_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["decisions_sha256", "reviewed", "expected_rows"],
          "properties": {
            "decisions_sha256": {"$ref": "#/$defs/sha256"},
            "reviewed": {"type": "integer", "minimum": 1},
            "expected_rows": {"type": "integer", "minimum": 1}
          }
        },
        "holdout": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "receipt_sha256",
            "decisions_sha256",
            "reviewed",
            "expected_rows",
            "status"
          ],
          "properties": {
            "receipt_sha256": {"$ref": "#/$defs/sha256"},
            "decisions_sha256": {"$ref": "#/$defs/sha256"},
            "reviewed": {"type": "integer", "minimum": 1},
            "expected_rows": {"type": "integer", "minimum": 1},
            "status": {"enum": ["passed", "failed", "blocked", "not_run"]}
          }
        },
        "fix": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "summary"],
          "properties": {
            "status": {"enum": ["localized", "not_applicable", "none"]},
            "summary": {"type": "string", "minLength": 1}
          }
        },
        "homologs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "homolog_result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "summary"],
          "properties": {
            "status": {"enum": ["passed", "failed", "blocked", "not_run"]},
            "summary": {"type": "string", "minLength": 1}
          }
        },
        "golden_approval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": {"enum": ["not_requested", "separate_review"]}
          }
        },
        "lesson": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path", "sha256", "rule", "next_review"],
          "properties": {
            "kind": {
              "enum": ["renderer", "fixture", "oracle", "taxonomy", "skill", "script", "review"]
            },
            "path": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/$defs/sha256"},
            "rule": {"type": "string", "minLength": 1},
            "next_review": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "queue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queue_id", "queue_sha256", "manifest_sha256"],
      "properties": {
        "queue_id": {"type": "string", "minLength": 1},
        "queue_sha256": {"$ref": "#/$defs/sha256"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decisions_sha256", "reviewed", "expected_rows"],
      "properties": {
        "decisions_sha256": {"$ref": "#/$defs/sha256"},
        "reviewed": {"type": "integer", "minimum": 1},
        "expected_rows": {"type": "integer", "minimum": 1}
      }
    },
    "holdout_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_sha256", "decisions_sha256", "reviewed", "expected_rows"],
      "properties": {
        "receipt_sha256": {"$ref": "#/$defs/sha256"},
        "decisions_sha256": {"$ref": "#/$defs/sha256"},
        "reviewed": {"type": "integer", "minimum": 1},
        "expected_rows": {"type": "integer", "minimum": 1}
      }
    },
    "observation": {"type": "string", "minLength": 1},
    "observation_details": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["row", "column", "glyph", "note"],
        "properties": {
          "row": {"type": "integer", "minimum": 0},
          "column": {"type": "integer", "minimum": 0},
          "glyph": {"type": "string"},
          "note": {"type": "string", "minLength": 1}
        }
      }
    },
    "owner_layer": {"type": "string", "minLength": 1},
    "hypothesis": {"type": "string", "minLength": 1},
    "expected_observation_if_true": {"type": "string", "minLength": 1},
    "falsifier": {"type": "string", "minLength": 1},
    "next_command": {"type": "string", "minLength": 1},
    "fix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary"],
      "properties": {
        "status": {"enum": ["localized", "not_applicable", "none"]},
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "homologs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "homolog_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary"],
      "properties": {
        "status": {"enum": ["passed", "failed", "blocked", "not_run"]},
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "holdout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "result"],
      "properties": {
        "status": {"enum": ["passed", "failed", "blocked", "not_run"]},
        "result": {"type": "string", "minLength": 1}
      }
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256", "rule", "next_review"],
      "properties": {
        "kind": {
          "enum": ["renderer", "fixture", "oracle", "taxonomy", "skill", "script", "review"]
        },
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "rule": {"type": "string", "minLength": 1},
        "next_review": {"type": "string", "minLength": 1}
      }
    },
    "golden_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["not_requested", "separate_review"]}
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
